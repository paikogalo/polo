NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Correos administrativos autorizados, separados por comas. Alternativamente usa app_metadata.role=admin.
ADMIN_EMAILS=
# Acceso alternativo con contraseña protegida del Dashboard. Guarda solo el SHA-256, nunca la contraseña en texto plano.
ADMIN_EMAIL=
ADMIN_PASSWORD_SHA256=
ADMIN_SESSION_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_CAMPAIGN_VIDEO_URL=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_WHATSAPP=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_FLICKR=
# Atención humana del chatbot. Usa números con código de país, por ejemplo 593XXXXXXXXX.
NEXT_PUBLIC_WHATSAPP_1=
NEXT_PUBLIC_WHATSAPP_LABEL_1=
NEXT_PUBLIC_WHATSAPP_2=
NEXT_PUBLIC_WHATSAPP_LABEL_2=
NEXT_PUBLIC_WHATSAPP_3=
NEXT_PUBLIC_WHATSAPP_LABEL_3=
# IDs separados por comas, por ejemplo: dQw4w9WgXcQ,aqz-KE-bpKQ
NEXT_PUBLIC_YOUTUBE_VIDEO_IDS=
RESEND_API_KEY=
# Buzón central para necesidades, perfiles laborales y avisos de comunidad.
CONTACT_TO_EMAIL=info@depoloapoloavanzamoscotopaxi.com
# Compatibilidad con instalaciones anteriores; se usa solo si CONTACT_TO_EMAIL está vacío.
APPLICATIONS_TO_EMAIL=
APPLICATIONS_FROM_EMAIL=
COMMUNITY_FROM_EMAIL=
# Secreto compartido con Make, Zapier u otra automatización que envíe publicaciones oficiales.
SOCIAL_WEBHOOK_SECRET=
# Escucha digital (/escuchadigital). Máximo tres cuentas: correo:SHA256_DE_LA_CONTRASEÑA separadas por comas.
ESCUCHA_USERS=
# Secreto de sesión del módulo (mínimo 32 caracteres; genera con: openssl rand -hex 32).
ESCUCHA_SESSION_SECRET=
# Fuentes RSS adicionales: "Nombre|https://feed,Nombre 2|https://feed" (medios de Cotopaxi, Google Alerts, YouTube).
ESCUCHA_EXTRA_FEEDS=
# Entrega automática al grupo de Telegram del equipo.
ESCUCHA_TELEGRAM_BOT_TOKEN=
ESCUCHA_TELEGRAM_CHAT_ID=
# Protege /api/escucha/cron; Vercel Cron lo envía automáticamente como Bearer.
CRON_SECRET=
